# Browser RPC policy (post-2026-05-19 audit, H5):
#   The SPA intentionally ignores these VITE_* browser RPC values and always falls back to
#   https://solana-rpc.publicnode.com until a reviewed runtime `/config` proxy exists.
#   Vite inlines VITE_* values into the public JS bundle, so paid/provider RPC URLs must not
#   live here. Operator/server-side code keeps using Helius via the non-VITE SOLANA_RPC_URL below.
VITE_SOLANA_BROWSER_RPC_URL=
VITE_SOLANA_BROWSER_WS_URL=
# Deprecated browser RPC knobs retained only so old local env files remain understandable.
VITE_SOLANA_RPC_URL=
VITE_SOLANA_READ_RPC_FALLBACK_URLS=
VITE_SOLANA_WS_URL=
# Server/operator/script reads can use the raw paid API-key URL from ignored
# local/provider env. Never put raw API-key URLs in VITE_* fields.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<helius-api-key>
