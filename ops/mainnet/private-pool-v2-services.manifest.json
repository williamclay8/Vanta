{
  "version": "vanta-mainnet-services-manifest-0.1",
  "network": "mainnet-beta",
  "mainnetReady": false,
  "productionReady": false,
  "secretPolicy": "names-only-no-secret-values",
  "stagingDeployments": [
    {
      "id": "pay",
      "provider": "render",
      "environment": "staging",
      "serviceId": "srv-d7j3ggqqqhas739for80",
      "serviceName": "Vanta",
      "url": "https://vanta-0wwi.onrender.com",
      "repo": "https://github.com/williamclay8/Vanta",
      "branch": "main",
      "startCommand": "npm run pay:operator",
      "healthChecks": ["/health"],
      "readinessChecks": ["/v1/status"],
      "auth": {
        "kind": "bearer-token",
        "secretRef": "VANTA_PAY_SECRET_KEY_REF"
      },
      "storage": {
        "durableStoreConfigured": true,
        "kind": "postgres-jsonb-snapshot-store",
        "secretRef": "VANTA_PAY_DATABASE_URL_REF"
      },
      "privatePool": {
        "operatorUrl": "https://vanta-staging-private-pool-v2.onrender.com",
        "operatorTokenRef": "VANTA_PAY_PRIVATE_POOL_OPERATOR_TOKEN_REF"
      },
      "productionReady": false
    },
    {
      "id": "private-pool-v2",
      "provider": "render",
      "environment": "staging",
      "serviceId": "srv-d7j4aod7vvec73ahsqlg",
      "serviceName": "vanta-staging-private-pool-v2",
      "url": "https://vanta-staging-private-pool-v2.onrender.com",
      "repo": "https://github.com/williamclay8/Vanta",
      "branch": "main",
      "startCommand": "npm run private-pool-v2:operator",
      "healthChecks": ["/health"],
      "readinessChecks": ["/state/private-pool-v2-status"],
      "auth": {
        "kind": "bearer-token",
        "secretRef": "VANTA_PRIVATE_POOL_V2_OPERATOR_TOKEN_REF"
      },
      "storage": {
        "durableStoreConfigured": true,
        "kind": "postgres-jsonb-snapshot-store",
        "secretRef": "VANTA_PRIVATE_POOL_V2_DATABASE_URL_REF"
      },
      "productionReady": false
    }
  ],
  "services": [
    {
      "id": "indexer",
      "image": "${VANTA_INDEXER_IMAGE}",
      "startCommand": "npm run private-pool-v2:indexer",
      "deployedService": {
        "provider": "render",
        "environment": "production",
        "serviceId": "srv-d7jfqru7r5hc73b6oelg",
        "serviceName": "vanta-prod-private-pool-v2-indexer",
        "url": "https://vanta-prod-private-pool-v2-indexer.onrender.com",
        "repo": "https://github.com/williamclay8/Vanta",
        "branch": "main",
        "commit": "1c92ba969b8bb145df3cd1a254ab54aa9ed3b911",
        "buildCommand": "npm install; npm run build",
        "buildEnvironment": {
          "NPM_CONFIG_INCLUDE": "dev",
          "NPM_CONFIG_PRODUCTION": "false"
        },
        "healthChecks": ["/health"],
        "readinessChecks": ["/ready"],
        "auth": {
          "kind": "bearer-token",
          "secretRef": "VANTA_INDEXER_AUTH_TOKEN_REF"
        },
        "storage": {
          "durableStoreConfigured": true,
          "kind": "postgres-jsonb-snapshot-store",
          "secretRef": "VANTA_PRIVATE_POOL_V2_INDEXER_DATABASE_URL_REF"
        },
        "lastVerifiedAt": "2026-04-21T04:39:14Z",
        "lastVerifiedHealthRef": "curl -fsS https://vanta-prod-private-pool-v2-indexer.onrender.com/health",
        "productionReady": false,
        "mainnetReady": false
      },
      "replicas": {
        "minimum": 2,
        "maximum": 6
      },
      "env": [
        { "name": "VANTA_PRIVATE_POOL_V2_INDEXER_DATABASE_URL", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_INDEXER_AUTH_TOKEN", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_INDEXER_NETWORK", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_INDEXER_RPC_URL", "required": true }
      ],
      "healthChecks": ["/health", "/v1/commitments", "/v1/roots/latest"],
      "persistence": {
        "required": true,
        "kind": "durable-database"
      }
    },
    {
      "id": "relayer",
      "image": "${VANTA_RELAYER_IMAGE}",
      "startCommand": "npm run private-pool-v2:relayer",
      "replicas": {
        "minimum": 2,
        "maximum": 6
      },
      "env": [
        { "name": "VANTA_PRIVATE_POOL_V2_RELAYER_DATABASE_URL", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_RELAYER_AUTH_TOKEN", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_RELAYER_FEE_WALLET", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_RELAYER_RPC_URL", "required": true }
      ],
      "healthChecks": ["/health", "/v1/claims/quote"],
      "persistence": {
        "required": true,
        "kind": "durable-database"
      }
    },
    {
      "id": "prover",
      "image": "${VANTA_PROVER_IMAGE}",
      "startCommand": "npm run private-pool-v2:prover",
      "replicas": {
        "minimum": 2,
        "maximum": 12
      },
      "env": [
        { "name": "VANTA_PRIVATE_POOL_V2_PROVER_AUTH_TOKEN", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_PROVER_DATABASE_URL", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_PROVER_ARTIFACT_PATH", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_PROVER_WORKER_COUNT", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_PROVER_KEYSET", "required": true }
      ],
      "healthChecks": ["/health", "/v1/proofs/health"],
      "persistence": {
        "required": true,
        "kind": "artifact-store-plus-job-log"
      }
    },
    {
      "id": "verifier",
      "image": "${VANTA_VERIFIER_IMAGE}",
      "startCommand": "npm run private-pool-v2:verifier",
      "replicas": {
        "minimum": 2,
        "maximum": 6
      },
      "env": [
        { "name": "VANTA_PRIVATE_POOL_V2_VERIFIER_DATABASE_URL", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_VERIFIER_AUTH_TOKEN", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_VERIFIER_KEYSET", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_VERIFIER_NETWORK", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_INDEXER_URL", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_INDEXER_AUTH_TOKEN", "required": true }
      ],
      "healthChecks": ["/health", "/v1/proofs/accept"],
      "persistence": {
        "required": true,
        "kind": "durable-database"
      }
    },
    {
      "id": "operator",
      "image": "${VANTA_OPERATOR_IMAGE}",
      "startCommand": "npm run private-pool-v2:operator",
      "replicas": {
        "minimum": 2,
        "maximum": 8
      },
      "env": [
        { "name": "VANTA_PRIVATE_POOL_V2_DATABASE_URL", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_OPERATOR_AUTH_TOKEN", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_RUNTIME_MODE", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_INDEXER_URL", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_INDEXER_AUTH_TOKEN", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_PROVER_URL", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_PROVER_AUTH_TOKEN", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_RELAYER_URL", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_RELAYER_AUTH_TOKEN", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_VERIFIER_URL", "required": true },
        { "name": "VANTA_PRIVATE_POOL_V2_VERIFIER_AUTH_TOKEN", "required": true }
      ],
      "healthChecks": ["/health", "/state/private-pool-v2-status"],
      "persistence": {
        "required": true,
        "kind": "durable-database"
      }
    }
  ],
  "releaseGates": [
    "npm run mainnet:readiness-check",
    "npm run mainnet:service-contract-check",
    "npm run mainnet:deployment-manifest-check",
    "npm run mainnet:private-pool-v2-production-smoke-check",
    "npm run private-pool-v2:service-network-check",
    "npm run mainnet:approval-gates-check",
    "npm run private-pool-v2:verify",
    "npm run private-core:verify",
    "npm run pay:verify"
  ],
  "rollback": {
    "required": true,
    "strategy": "blue-green-or-fast-revert-to-last-healthy-manifest"
  }
}
